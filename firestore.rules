rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // İstemciler doğrudan Firestore'a erişmez. Tüm okuma/yazma yalnızca
      // Cloud Functions içindeki Admin SDK üzerinden yapılır (deny-all).
      allow read, write: if false;
    }
  }
}
