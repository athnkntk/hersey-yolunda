# Herşey Yolunda — üretim ortam değişkenleri (Render + Neon)
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun: cp .env.example .env
# Gizli değerleri asla depoya commit etmeyin. Render'da bu değerleri panelden girin.

# Zorunlu — Neon bağlantı adresi (Neon panosinden kopyalanır, sonunda sslmode=require olur)
DATABASE_URL=

# Zorunlu — 32 baytlık hex anahtar. Üret: openssl rand -hex 32
# UYARI: Bu anahtar değiştirilirse mevcut şifreli alanlar (telefon, cihaz token'ları) çözülemez.
DATA_ENCRYPTION_KEY=

# Zorunlu — 32 baytlık hex anahtar. Üret: openssl rand -hex 32
LOOKUP_KEY=

# Zorunlu (Render) — dış zamanlayıcı anahtarı. cron-job.org /v1/tick ucunu 10 dakikada bir
# POST {"secret": TICK_SECRET} ile çağırır. Üret: openssl rand -hex 32
TICK_SECRET=

# Zamanlayıcı modu: Render'da external (dış cron tetikler), yerelde internal (15 sn aralıkla kendiliğinden)
SCHEDULER_MODE=external

# İsteğe bağlı — canlı push bildirim (APNs). .p8 anahtarı Apple Developer hesabından üretilir.
APNS_ENABLED=false
APNS_KEY_ID=
APNS_TEAM_ID=2HBFPNCMR8
# APNs .p8 anahtarının tam PEM içeriği (tek satırda \n kullanarak veya dosya içeriği)
APNS_PRIVATE_KEY=
APNS_TOPIC=com.herseyyolunda.app
APNS_SANDBOX=true

# Alternatif docker-compose yığını için ek olarak: DOMAIN, POSTGRES_PASSWORD (bkz. docker-compose.yml)
